# Copy this file to .env and adjust if you want non-default credentials/ports.
# docker-compose.yml falls back to the defaults shown here if .env is absent.

DB_ROOT_PASSWORD=rootpass
DB_NAME=db_absensi.kry
DB_USER=absensi
DB_PASS=absensi

WEB_PORT=8080
DB_PORT=3307
PHPMYADMIN_PORT=8081

REGISTRATION_MASTER_KEY=put-a-long-random-32-characters-secret-here

# Web Push (notifikasi PWA). Buat kunci dengan: php generate_vapid_keys.php
# Jangan ganti setelah pengguna berlangganan - semua langganan lama jadi tidak valid.
# VAPID_SUBJECT harus mailto: atau https:// kontak admin.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
