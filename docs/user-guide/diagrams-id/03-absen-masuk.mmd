flowchart TD
  A["Buka halaman absen<br/>dan pilih status"] --> C{"Status Hadir?"}
  C -- "Tidak: Sakit, Cuti, OFF" --> G(["Tersimpan tanpa<br/>kamera dan lokasi"])
  C -- "Ya" --> D["Lihat ke kamera"]
  D --> E{"Bekerja di<br/>lokasi tetap?"}
  E -- "Tidak: karyawan lapangan" --> H(["Jam masuk tersimpan"])
  E -- "Ya" --> F{"Berada di<br/>area cabang?"}
  F -- "Ya" --> H
  F -- "Tidak" --> I(["Ditolak: mendekat<br/>ke cabang, coba lagi"])
  classDef step fill:#DCE6F1,stroke:#4F6D9A,stroke-width:2px,color:#14253D;
  classDef ask fill:#FFFFFF,stroke:#4F6D9A,stroke-width:2px,color:#14253D;
  classDef ok fill:#E3F1E3,stroke:#3C8A4E,stroke-width:2px,color:#12361C;
  classDef warn fill:#FDF1DC,stroke:#B4750A,stroke-width:2px,color:#3A2604;
  classDef bad fill:#FBE6EE,stroke:#B03A5B,stroke-width:2px,color:#4A0F20;
  class A,D step; class C,E,F ask; class G,H ok; class I bad;
